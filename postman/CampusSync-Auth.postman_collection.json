{
  "info": {
    "name": "CampusSync Authentication",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "email", "value": "replace-with-test-email" },
    { "key": "password", "value": "replace-with-test-password" },
    { "key": "selectedRole", "value": "STUDENT" },
    { "key": "accessToken", "value": "" }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"selectedRole\": \"{{selectedRole}}\"\n}" },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.expect(body.token).to.be.a('string').and.not.empty;",
              "pm.expect(body.user.role).to.eql(pm.collectionVariables.get('selectedRole'));",
              "pm.collectionVariables.set('accessToken', body.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Current user",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/auth/me"
      }
    }
  ]
}
